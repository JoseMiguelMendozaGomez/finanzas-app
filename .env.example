# Copia este archivo a .env y completa los valores reales.
# .env* ya está en .gitignore — nunca subas credenciales reales al repositorio.

# Prisma / Supabase (PostgreSQL)
# DATABASE_URL: connection pooler (Transaction mode, puerto 6543) — la usa la app en runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432) — la usa Prisma solo para migraciones
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Resend (envío de correos: recuperar contraseña, etc.)
# Opcional en desarrollo — sin esta clave, los correos se imprimen en la
# consola del servidor en vez de enviarse de verdad. Conseguí una clave
# gratis en https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Inverza <onboarding@resend.dev>"
