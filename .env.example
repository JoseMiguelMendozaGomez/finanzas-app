# Copia este archivo a .env y completa los valores reales.
# .env* ya está en .gitignore — nunca subas credenciales reales al repositorio.

# Prisma / Supabase (PostgreSQL)
# DATABASE_URL: connection pooler (Transaction mode, puerto 6543) — la usa la app en runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432) — la usa Prisma solo para migraciones
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
